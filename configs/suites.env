# Fast, broad baseline used by the evaluation scripts.
CORE_TASKS=mmlu_pro,gpqa_diamond_zeroshot,hellaswag,arc_challenge,winogrande,gsm8k,ifeval

# Frozen Open LLM Leaderboard v2-style groups. This is substantially more expensive.
OPEN_LLM_TASKS=leaderboard_bbh,leaderboard_gpqa,leaderboard_mmlu_pro,leaderboard_musr,leaderboard_ifeval,leaderboard_math_hard

# Japanese numerical reasoning. Discover more current Japanese tasks with lm-eval ls.
JAPANESE_TASKS=jfinqa
