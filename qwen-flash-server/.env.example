CUDA_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
LLAMA_CPP_REF=911f6cdc8ab8a530b2bee09ee61471a6f3178eeb
CUDA_ARCHITECTURES=86

# Relative paths are resolved from qwen-flash-server/docker-compose.yml.
MODEL_ROOT=../weights
MODEL_PATH=/models/qwen38-flash-next/UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf
MODEL_ALIAS=qwen3.8-flash-next

PORT=8080
CONTAINER_PORT=8080
CTX_SIZE=261888
PARALLEL=1
BATCH_SIZE=2048
UBATCH_SIZE=256
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
TENSOR_SPLIT=1,1
N_GPU_LAYERS=999
CONT_BATCHING=true
TEMPERATURE=0.2
TOP_P=0.95